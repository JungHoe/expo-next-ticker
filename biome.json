{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/.expo",
      "!**/dist",
      "!**/build",
      "!**/.turbo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "react": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": "packages/*는 플랫폼 중립이다(CLAUDE.md). 앱 전용 코드는 apps/mobile에 둔다",
                  "react-dom": "packages/*는 플랫폼 중립이다(CLAUDE.md). 웹 전용 코드는 apps/web에 둔다",
                  "next": "packages/*는 플랫폼 중립이다(CLAUDE.md)",
                  "expo": "packages/*는 플랫폼 중립이다(CLAUDE.md)"
                },
                "patterns": [
                  {
                    "group": [
                      "react-native/*",
                      "react-native-*",
                      "next/*",
                      "expo-*",
                      "@expo/*"
                    ],
                    "message": "packages/*는 플랫폼 중립이다(CLAUDE.md)"
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "packages/*는 플랫폼 중립이다(CLAUDE.md)",
                  "document": "packages/*는 플랫폼 중립이다(CLAUDE.md)",
                  "navigator": "packages/*는 플랫폼 중립이다(CLAUDE.md)",
                  "localStorage": "packages/*는 플랫폼 중립이다(CLAUDE.md)"
                }
              }
            }
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
